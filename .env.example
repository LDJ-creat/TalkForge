# -----------------------------------------------------------------------------

# TalkForge runtime configuration

# -----------------------------------------------------------------------------

# Provider selection: use "mock" for local development without real API keys.

# Set a real provider id and the matching secrets when enabling P1 integrations.

#

# Server-only variables must NEVER be prefixed with NEXT_PUBLIC_.

# -----------------------------------------------------------------------------



# App URLs (NEXT_PUBLIC_APP_BASE_URL is safe for the browser)

APP_BASE_URL=http://localhost:3000

NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

NEXT_PUBLIC_DEV_USER_ID=99999999-9999-4999-8999-999999999999



# Database (required in production; optional for mock-only local dev/tests)

DATABASE_PROVIDER=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talkforge



# Queue: memory (default) or redis

# Docker Compose uses port 6381; native Redis typically uses 6379.

QUEUE_PROVIDER=redis

REDIS_URL=redis://localhost:6379



# Object storage: mock | local | s3 | r2 | oss | minio

STORAGE_PROVIDER=local

STORAGE_SIGNING_SECRET=talkforge-dev-storage-secret

LOCAL_STORAGE_ROOT=.data/storage



# Real object storage credentials (required when STORAGE_PROVIDER is s3/r2/oss/minio)

# Recommended for China staging/production (Aliyun OSS, S3-compatible API):

# STORAGE_PROVIDER=oss

# STORAGE_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# STORAGE_BUCKET=talkforge-audio

# STORAGE_ACCESS_KEY_ID=

# STORAGE_SECRET_ACCESS_KEY=

# STORAGE_REGION=oss-cn-hangzhou

#

# AWS S3 example:

# STORAGE_PROVIDER=s3

# STORAGE_ENDPOINT=https://s3.amazonaws.com

# STORAGE_REGION=us-east-1



# Realtime voice provider: mock | qwen-omni

# (doubao is planned for a future P1 task and is not implemented yet)

REALTIME_PROVIDER=qwen-omni

REALTIME_API_KEY=

# REALTIME_API_SECRET is unused for qwen-omni; only REALTIME_API_KEY (DashScope API Key) is required.

REALTIME_BASE_URL=https://dashscope.aliyuncs.com

REALTIME_MODEL=qwen3.5-omni-flash-realtime

# qwen3.5-* models use Tina; Cherry is for qwen3-omni-* only.
REALTIME_VOICE=Tina

REALTIME_TOKEN_TTL_SEC=300
REALTIME_PROXY_PORT=3002
NEXT_PUBLIC_REALTIME_PROXY_URL=ws://localhost:3002

# Server-side VAD for Qwen Omni (optional): server_vad | semantic_vad
# server_vad is more tolerant of quiet mics; semantic_vad filters filler noise (qwen3.5).
# REALTIME_VAD_MODE=server_vad

# -----------------------------------------------------------------------------
# Realtime browser audio (client-side; NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
# Mic DSP mode: balanced (default) | standard | raw
# - balanced: noise suppression on, echo cancellation off (recommended with speakers)
# - standard: full browser DSP (better with headphones)
# - raw: no browser DSP (debug only)
# NEXT_PUBLIC_REALTIME_MIC_PROCESSING=balanced

# Software gain before PCM upload when the mic level is very low.
# NEXT_PUBLIC_REALTIME_MIC_GAIN=6

# Drop uplink frames quieter than this peak (0 disables the gate).
# NEXT_PUBLIC_REALTIME_NOISE_GATE=0.012

# Voice barge-in (interrupt AI by speaking while it is playing):
# - Speaker playback: keep false and use the "Interrupt AI" button (avoids false triggers).
# - Headphones: set true if you want voice interrupt.
NEXT_PUBLIC_REALTIME_BARGE_IN=false
# NEXT_PUBLIC_REALTIME_BARGE_IN=true
# NEXT_PUBLIC_REALTIME_BARGE_IN_PEAK=0.14
# NEXT_PUBLIC_REALTIME_BARGE_IN_ARM_MS=1200

#

# Qwen Omni setup (DashScope / Model Studio):

# 1. Create an API key in the Alibaba Cloud Model Studio console.

# 2. Set REALTIME_PROVIDER=qwen-omni and REALTIME_API_KEY to the server-only key.

# 3. For international regions, set REALTIME_BASE_URL=https://dashscope-intl.aliyuncs.com

# 4. The backend mints short-lived st-* tokens via POST /api/v1/tokens; the browser

#    receives only the ephemeral token plus the WebSocket endpoint URL.

# 5. Scenario system instructions are returned in credentials.metadata.sessionUpdateEvent

#    for the client to send as session.update after connecting (see P1-007).



# ASR provider: mock | paraformer

ASR_PROVIDER=paraformer

ASR_API_KEY=

ASR_BASE_URL=https://dashscope.aliyuncs.com

ASR_MODEL=paraformer-realtime-8k-v2

#

# DashScope Paraformer setup (Alibaba Cloud Model Studio / 百炼):

# 1. Create a China (Beijing) region API key in the Model Studio console.

# 2. Set ASR_PROVIDER=paraformer and ASR_API_KEY to the server-only key.

# 3. Ensure uploaded turn audio is stored privately (STORAGE_PROVIDER != mock).

# 4. paraformer-realtime-8k-v2 requires mono PCM at 8 kHz. The worker converts

#    uploaded webm/wav turn audio with ffmpeg before calling the WebSocket API.

# 5. Install ffmpeg on worker hosts and keep it on PATH.

# 6. ASR worker jobs are idempotent per turn and record ai_invocation_logs when tracing is enabled.



# Text LLM providers: mock | openai | dashscope | <custom OpenAI-compatible id + LLM_BASE_URL>

LLM_CORRECTION_PROVIDER=dashscope

LLM_REPORT_PROVIDER=dashscope

LLM_GOAL_JUDGE_PROVIDER=dashscope

SCENARIO_PROGRESS_JUDGE_USER_TURN_INTERVAL=1

LLM_API_KEY=

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

LLM_MODEL=qwen-plus

#

# OpenAI example:

# LLM_CORRECTION_PROVIDER=openai

# LLM_REPORT_PROVIDER=openai

# LLM_GOAL_JUDGE_PROVIDER=openai

# LLM_API_KEY=

# LLM_BASE_URL=https://api.openai.com/v1

# LLM_MODEL=gpt-4o-mini



# TTS provider: mock | cosyvoice

TTS_PROVIDER=cosyvoice

TTS_API_KEY=

TTS_BASE_URL=https://dashscope.aliyuncs.com

TTS_MODEL=cosyvoice-v3-flash

TTS_VOICE=longxiaochun_v3



# Pronunciation evaluation: mock | iflytek-ise

PRONUNCIATION_PROVIDER=iflytek-ise

PRONUNCIATION_API_KEY=

PRONUNCIATION_API_SECRET=

PRONUNCIATION_APP_ID=

PRONUNCIATION_WS_BASE_URL=wss://ise-api.xfyun.cn/v2/ise

#

# iFlytek ISE setup (free conversation + Shadowing):

# 1. Create an app in the iFlytek open platform and enable the ISE (speech evaluation) service.

# 2. Set PRONUNCIATION_PROVIDER=iflytek-ise with APP_ID, API_KEY, and API_SECRET.

# 3. Worker jobs convert uploaded webm/wav audio to mono PCM 16 kHz with ffmpeg.

# 4. Free conversation uses the ASR transcript as iFlytek read_sentence reference text (>=2 words).

# 5. Shadowing uses report/scenario standard text as reference text.

# 6. Evaluation jobs record ai_invocation_logs when tracing is enabled.



# Provider call resilience defaults (optional; used by shared runtime utilities)

# PROVIDER_DEFAULT_TIMEOUT_MS=30000

# PROVIDER_DEFAULT_MAX_ATTEMPTS=3

# PROVIDER_DEFAULT_INITIAL_RETRY_DELAY_MS=250

# PROVIDER_DEFAULT_MAX_RETRY_DELAY_MS=5000

# PROVIDER_DEFAULT_BACKOFF_MULTIPLIER=2

# PROVIDER_DEFAULT_MAX_CONCURRENT_CALLS=10

# PROVIDER_HEALTH_CHECK_TIMEOUT_MS=5000



# AI invocation tracing (P1-005)

AI_TRACING_ENABLED=true

AI_TRACING_RAW_REQUEST=true

AI_TRACING_RAW_RESPONSE=true

AI_TRACING_RAW_STORAGE=file

AI_TRACING_SAMPLE_RATE=1

AI_TRACING_RETENTION_DAYS=30

# Hint only; cleanup is handled by later observability/retention jobs (P1-014).

AI_TRACING_REDACT_PII=true

AI_TRACING_LOCAL_ROOT=.storage/ai-traces



# Session usage safety limits (P1-014)

SESSION_MAX_REALTIME_DURATION_SEC=0

SESSION_MAX_TURNS=0

SESSION_MAX_ASR_JOBS=50

SESSION_MAX_REPORT_ATTEMPTS=5



# Observability health detail auth (P1-014; required in production for /api/health?detail=1)

OPS_HEALTH_DETAIL_TOKEN=

